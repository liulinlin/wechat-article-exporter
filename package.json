{
  "name": "wechat-article-exporter",
  "version": "2.3.16",
  "type": "module",
  "scripts": {
    "debug": "nuxt dev --inspect",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "cross-env NITRO_PRESET=cloudflare_pages nuxt build && npx wrangler pages dev ./dist",
    "deploy:cloudflare": "cross-env NITRO_PRESET=cloudflare_pages nuxt build && npx wrangler pages deploy ./dist --project-name=wechat-article-exporter --branch=master",
    "format": "biome check --write",
    "postinstall": "nuxt prepare",
    "docker:build": "docker build --build-arg VERSION=$npm_package_version -t ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version .",
    "docker:publish": "docker push ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@nuxt/ui": "^2.17.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@vueuse/core": "^10.11.0",
    "@vueuse/nuxt": "^10.11.0",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.12",
    "nuxt": "^3.12.3",
    "uuid": "^11.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/file-saver": "^2.0.7",
    "@types/turndown": "^5.0.5",
    "cross-env": "^10.1.0",
    "prettier": "^3.5.2",
    "tailwindcss-debug-screens": "^2.2.1",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}